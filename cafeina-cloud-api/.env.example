PORT=3100
NODE_ENV=production

# Reuse the existing PostgreSQL/Neon database connection.
# The CAFEÍNA service uses its own schema and does not touch legacy Grupo Lua tables.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true

# Optional canonical public URL for diagnostics/links.
PUBLIC_BASE_URL=https://cafeina-cloud-api.example.com
