{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GRUPO_LUA_API_URL": "https://grupo-lua-control-api.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-apk": {
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GRUPO_LUA_API_URL": "https://grupo-lua-control-api.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-ios-internal": {
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GRUPO_LUA_API_URL": "https://grupo-lua-control-api.onrender.com"
      }
    },
    "production-store": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_GRUPO_LUA_API_URL": "https://grupo-lua-control-api.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
