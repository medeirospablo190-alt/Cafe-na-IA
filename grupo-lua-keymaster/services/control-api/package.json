{
  "name": "@grupo-lua/control-api",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start:free",
    "start:production": "npm run production:check && node src/bootstrap.js",
    "start:free": "npm run production:check && npm run migrate && node src/bootstrap.js",
    "dev": "node --watch src/bootstrap.js",
    "migrate": "node scripts/migrate.mjs",
    "hash:keymaster": "node scripts/hash-keymaster.mjs",
    "production:check": "node scripts/production-readiness.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  }
}
