PORT=3100
DATABASE_URL=postgresql://user:password@host:5432/grupo_lua
DATABASE_SSL=true

# Gere com: npm run hash:keymaster -- /caminho/para/KEYMASTER_ACCESS_KEY_5000.txt
KEYMASTER_ACCESS_HASH=scrypt$32768$8$1$<salt-base64url>$<hash-base64url>

# Gere valores aleatórios fortes e mantenha SOMENTE no servidor/Render.
SESSION_PEPPER=replace-with-64-plus-random-characters
DEVICE_FINGERPRINT_PEPPER=replace-with-another-64-plus-random-characters

# off | report | enforce
APP_INTEGRITY_MODE=report
# Em produção, aponte para um verificador server-side de Play Integrity / App Attest.
APP_INTEGRITY_VERIFY_URL=
APP_INTEGRITY_VERIFY_TOKEN=

# App 2 nunca recebe estes segredos.
# Habilita a integração externa de reinício. Manutenção interna continua sendo
# controlada pela API e exige autorização DEV de uso único.
CRITICAL_ACTIONS_ENABLED=false
APP1_RESTART_WEBHOOK=
APP1_CONTROL_WEBHOOK_TOKEN=
