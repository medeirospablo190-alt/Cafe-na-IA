PORT=3100
NODE_ENV=production

# Em Render, use o connectionString interno do Postgres e mantenha DATABASE_SSL=false.
# Fora do Render, use a URL externa com TLS conforme o provedor exigir.
DATABASE_URL=postgresql://user:password@host:5432/grupo_lua
DATABASE_SSL=false

# URL HTTPS pública CANÔNICA da Control API dedicada.
# NUNCA use https://cafe-na-ia.onrender.com aqui: esse endereço é somente o portal de downloads.
PUBLIC_BASE_URL=https://grupo-lua-control-api.example.com

# Gere com: npm run hash:keymaster -- /caminho/para/KEYMASTER_ACCESS_KEY.txt
# Guarde apenas o verificador scrypt no servidor. A chave original não entra no GitHub.
KEYMASTER_ACCESS_HASH=scrypt$32768$8$1$<salt-base64url>$<hash-base64url>

# Gere valores aleatórios fortes e mantenha SOMENTE no servidor/Render.
SESSION_PEPPER=replace-with-64-plus-random-characters
DEVICE_FINGERPRINT_PEPPER=replace-with-another-64-plus-random-characters

# off | report | enforce
# Comece em report durante a integração do provedor; antes da liberação final dos apps,
# configure um verificador real e migre para enforce.
APP_INTEGRITY_MODE=report
APP_INTEGRITY_VERIFY_URL=
APP_INTEGRITY_VERIFY_TOKEN=

# Versões do onboarding/termos. Alterar a versão pode exigir novo aceite no App 1.
APP1_TERMS_VERSION=1.0
APP1_PRIVACY_VERSION=1.0

# Ações externas de reinício ficam desligadas até o webhook privado estar configurado.
CRITICAL_ACTIONS_ENABLED=false
APP1_RESTART_WEBHOOK=
APP1_CONTROL_WEBHOOK_TOKEN=
