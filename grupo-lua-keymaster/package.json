{
  "name": "grupo-lua-platform",
  "version": "0.10.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "api:start": "npm --workspace @grupo-lua/control-api start",
    "api:dev": "npm --workspace @grupo-lua/control-api run dev",
    "api:migrate": "npm --workspace @grupo-lua/control-api run migrate",
    "keymaster:start": "npm --workspace @grupo-lua/keymaster start",
    "keymaster:typecheck": "npm --workspace @grupo-lua/keymaster run typecheck",
    "app1:start": "npm --workspace @grupo-lua/app1 start",
    "app1:typecheck": "npm --workspace @grupo-lua/app1 run typecheck",
    "app1-probe:start": "npm --workspace @grupo-lua/app1-probe start",
    "app1-probe:typecheck": "npm --workspace @grupo-lua/app1-probe run typecheck",
    "contracts:test": "node --test packages/contracts/test/*.test.mjs",
    "versions:check": "node scripts/check-app-versions.mjs",
    "assets:check": "node scripts/check-mobile-assets.mjs && node scripts/check-app1-background.mjs",
    "login:check": "node scripts/check-grupo-lua-login.mjs"
  }
}
