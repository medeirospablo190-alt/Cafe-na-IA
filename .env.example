# Nunca coloque senhas reais aqui. Gere somente os verificadores scrypt com:
# npm run hash:download

NODE_ENV=production
PORT=3000

# Diretório PRIVADO, fora de /public e preferencialmente em disco persistente.
DOWNLOAD_DIR=/var/data/grupo-lua-downloads

# Autorizações temporárias / anti-bruteforce.
DOWNLOAD_TOKEN_TTL_SECONDS=180
DOWNLOAD_ATTEMPT_WINDOW_SECONDS=900
DOWNLOAD_BLOCK_SECONDS=1800
DOWNLOAD_MAX_FAILED_ATTEMPTS=6

# APP 1 — ADMINISTRADORES / ANDROID
DOWNLOAD_APP1_ANDROID_HASH=
DOWNLOAD_APP1_ANDROID_FILE=grupo-lua-app1.apk
DOWNLOAD_APP1_ANDROID_NAME=GRUPO-LUA-App1.apk
DOWNLOAD_APP1_ANDROID_VERSION=1.0.0

# APP 1 — ADMINISTRADORES / IOS
DOWNLOAD_APP1_IOS_HASH=
DOWNLOAD_APP1_IOS_FILE=grupo-lua-app1.ipa
DOWNLOAD_APP1_IOS_NAME=GRUPO-LUA-App1.ipa
DOWNLOAD_APP1_IOS_VERSION=1.0.0
# Alternativa ao arquivo local: URL HTTPS de TestFlight/Ad Hoc/outro provedor.
# Se definida, a URL de redirecionamento tem prioridade sobre FILE.
DOWNLOAD_APP1_IOS_REDIRECT_URL=

# KEYMASTER — DEV / ANDROID
DOWNLOAD_KEYMASTER_ANDROID_HASH=
DOWNLOAD_KEYMASTER_ANDROID_FILE=grupo-lua-keymaster.apk
DOWNLOAD_KEYMASTER_ANDROID_NAME=GRUPO-LUA-Keymaster.apk
DOWNLOAD_KEYMASTER_ANDROID_VERSION=1.0.0

# KEYMASTER — DEV / IOS
DOWNLOAD_KEYMASTER_IOS_HASH=
DOWNLOAD_KEYMASTER_IOS_FILE=grupo-lua-keymaster.ipa
DOWNLOAD_KEYMASTER_IOS_NAME=GRUPO-LUA-Keymaster.ipa
DOWNLOAD_KEYMASTER_IOS_VERSION=1.0.0
DOWNLOAD_KEYMASTER_IOS_REDIRECT_URL=
