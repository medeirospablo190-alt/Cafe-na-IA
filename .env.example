NODE_ENV=production
PORT=3000

# Persistent collector storage. Existing Render deployments can keep their
# current DOWNLOAD_DIR value; gateway-main.js still accepts it as a fallback.
CAFEINA_COLLECTOR_DATA_DIR=/var/data/cafeina-collector

# GitHub mirror. The old AVATAR_DUMP_GITHUB_* names are accepted temporarily
# by the code for deployment compatibility, but new configuration should use
# these neutral names.
CAFEINA_COLLECTOR_GITHUB_TOKEN=
CAFEINA_COLLECTOR_GITHUB_REPO=medeirospablo190-alt/Cafe-na-IA
CAFEINA_COLLECTOR_GITHUB_BRANCH=main

# Legacy V2.1 inventory trace compatibility.
INVENTORY_TRACE_DIR=/var/data/cafeina-collector/inventory-traces
INVENTORY_TRACE_GITHUB_PATH=inventory-traces
INVENTORY_TRACE_MAX_PER_WINDOW=30
INVENTORY_TRACE_WINDOW_SECONDS=600
INVENTORY_TRACE_MAX_RECORDS=2500
INVENTORY_TRACE_MAX_REMOTES=600

# Universal Trace V3.
INVENTORY_TRACE_V3_DIR=/var/data/cafeina-collector/inventory-traces-v3
INVENTORY_TRACE_V3_GITHUB_PATH=inventory-traces-v3
INVENTORY_TRACE_V3_MAX_PER_WINDOW=220
INVENTORY_TRACE_V3_WINDOW_SECONDS=600
INVENTORY_TRACE_V3_MAX_RECORDS=6000
INVENTORY_TRACE_V3_MAX_REMOTES=1000
INVENTORY_TRACE_V3_MAX_BATCHES=260
INVENTORY_TRACE_V3_BODY_LIMIT=3mb
